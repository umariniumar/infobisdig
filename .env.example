# Salin file ini menjadi .env.local untuk jalan lokal,
# dan isi nilai yang sama di Vercel: Project → Settings → Environment Variables.
# JANGAN pernah commit file .env.local atau menulis password asli di sini.

# --- Supabase (opsional tapi WAJIB bila kurator mau menambah/mengubah data) ---
# Tanpa ketiga nilai ini, aplikasi tetap jalan dengan membaca data seed di data/*.json,
# tapi tombol tambah/ubah/hapus kurator akan menampilkan pesan "database belum disiapkan".
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Login kurator (WAJIB diisi sebelum disebar ke mahasiswa) ---
# Password kurator. Buat yang panjang dan acak, misal 3 kata + angka.
# JANGAN pakai password yang sama dengan akun lain. Jangan tulis nilainya di repo.
CURATOR_PASSWORD=

# --- Bersihkan jadwal lama otomatis (cron harian 01:00 WIB) ---
# Rahasia untuk endpoint GET /api/cron/cleanup. Vercel Cron mengirim
# "Authorization: Bearer <nilai ini>" secara otomatis saat cron jalan.
# Buat yang panjang dan acak (misal 32 karakter huruf+angka), JANGAN pakai
# password akun lain, JANGAN tulis nilainya di repo. Tanpa ini, cron tidak jalan
# (endpoint mengembalikan 503) dan bersih-bersih hanya bisa manual lewat panel kurator.
CRON_SECRET=
